@{
    ViewBag.Titel = "Chat";
    var list = ViewBag.ChatMails as List<Mail>;
}
@model Mail

<h1>Chat mit @ViewBag.ChatName
    <a style="float:right" class="btn btn-secondary" asp-controller="Mail" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Zurück
    </a>
</h1>

@if (list?.Count > 0)
{
    <div style="max-height: 640px; overflow-y: auto;">
    @foreach (var ele in list)
    {
        var isOwnMessage = ele.SenderId == Model.SenderId;
        var alignment = isOwnMessage ? "justify-content-end" : "justify-content-start";
        var bgColor = isOwnMessage ? "bg-info text-white" : "bg-light text-dark";
        var delete = isOwnMessage ? "true" : "false";

        <div class="d-flex @alignment mb-3">
            
            <div class="card @bgColor" style="max-width: 75%; border-radius: 1rem;">
                
                <div class="card-body p-3">                  
                    <p class="mb-2">@ele.Text</p>
                </div>
                <div class="card-footer" style="position:relative;">
                    <a asp-action="CloseMail" asp-route-id="@ele.Id" asp-route-empfangen="@delete"
                       onclick="return confirm('Nachricht löschen?');" class="stretched-link">
                    </a>
                    <small class="text-muted d-block text-end">@ele.SendDate.ToString("g")</small>
                </div>
            </div>
        </div>
    }
    </div>
}
else
{
    <p>Keine Nachrichten vorhanden.</p>
}
<br />
<form asp-controller="Mail" asp-action="Chat" method="post" class="text-center">

    <input type="hidden" asp-for="SenderId" />
    <input type="hidden" asp-for="EmpfangerId" />

    @* <label asp-for="Text" class="form-label"></label> *@
    <textarea asp-for="Text" rows="3" style="width: 100%;resize:none;" placeholder="Nachricht eingeben..."></textarea>
    <br />
    <span asp-validation-for="Text" class="text-danger d-block"></span>
    <br />


    <button class="btn btn-success" type="submit">
        <i class="bi bi-send"></i> Senden
    </button>
</form>
