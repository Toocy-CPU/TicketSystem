@{
	ViewBag.Title = "EditTicket";
}
@model Ticket

<h1>Ticket bearbeiten
    <a style="float:right" class="btn btn-secondary" asp-route-id="@Model.Id" asp-action="TicketDetails">
        <i class="bi bi-arrow-left"></i> Zurück
    </a>
</h1>

<div class="card my-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">@Model.Title</h5>
            <small class="text-muted">Projekt: @Model.Project?.Title</small>
        </div>       
    </div>

    <div class="card-body" >
        <form asp-controller="Ticket" asp-action="EditTicket" method="post">
            <input type="hidden" asp-for="Id" />
            <label asp-for="Description" class="form-label">Text</label>
            <textarea asp-for="Description" rows="10" class="form-control">
                @Model.Description
            </textarea>
            <span asp-validation-for="Description"></span>

            <label class="form-label" asp-for="BearbeiterId">Bearbeiter</label>
            <select class="form-select" asp-for="BearbeiterId" asp-items="@ViewBag.Bearbeiter">
                <option value="-1">Kein Bearbeiter</option>
            </select>
            <br />
            <button class="btn btn-success" type="submit">
                <i class="bi bi-save"></i>  Änderungen speichern
                </button>
        </form>
    </div>

    <div class="card-footer">
       
    </div>
</div>
<br />