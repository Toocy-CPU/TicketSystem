@using TicketSystem.ViewModels
@model Statistic
@{
    ViewBag.Title = "AdminControl";
}

<h1>
    Willkommen Admin!
    <a style="float:right" class="btn btn-secondary" asp-controller="Home" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Zurück
    </a>
</h1>

<br />

<div class="mb-4">
    <a asp-controller="Projects" asp-action="Index" class="btn btn-success me-2">
        <i class="bi bi-kanban"></i> Projektverwaltung
    </a>
    <a asp-controller="Account" asp-action="UserList" class="btn btn-info">
        <i class="bi bi-people"></i> Benutzerverwaltung
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 text-center">
        <div class="card" style="background-color: transparent; border: none;">
            <h4 class="mb-3">Benutzerstatistik</h4>
            <canvas id="userChart" style="width:100%; max-width:auto; height:400px;display:block;margin:0 auto;"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const admins = @Model.Admins;
        const devs = @Model.Devs;
        const tester = @Model.Tester;

        new Chart(document.getElementById('userChart'), {
            type: 'bar',
            data: {
                labels: ['Admins', 'Devs', 'Tester'],
                datasets: [{
                    label: 'Anzahl',
                    data: [admins, devs, tester],
                    backgroundColor: ['#fd7e14', '#0d6efd', '#20c997']
                }]
            },
            options: {
                plugins: {
                    title: {
                        display: true,
                    },
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        precision: 0
                    }
                }
            }
        });
    </script>
}
